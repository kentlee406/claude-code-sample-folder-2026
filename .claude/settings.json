{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "additionalDirectories": []
  },
  "env": {
    "CLAUDE_PROJECT_NAME": "Claude Code 範例專案資料夾"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/on-stop.sh"
          }
        ]
      }
    ]
  }
}
